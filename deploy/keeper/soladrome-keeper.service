# The Soladrome keeper as a supervised service. Installed by setup.sh, updated by deploy.sh.
#
# It restarts on any exit, forever: a keeper that stops is the one failure it has
# (see MAINNET_RUNBOOK.md §7). It holds no authority on chain, so the hardening below is about
# the fee-payer key and the machine, not about the protocol.
[Unit]
Description=Soladrome keeper (permissionless cranks, fee payer only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=keeper
Group=keeper
EnvironmentFile=/etc/soladrome-keeper/keeper.env
ExecStart=/usr/local/bin/node /opt/soladrome-keeper/keeper.mjs --watch
Restart=always
RestartSec=15
MemoryMax=512M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/opt/soladrome-keeper /etc/soladrome-keeper

[Install]
WantedBy=multi-user.target

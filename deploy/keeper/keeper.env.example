# /etc/soladrome-keeper/keeper.env — written by deploy.sh, mode 600, owner keeper.
# Never commit the real file: KEEPER_RPC_URL carries an API key.

# The keeper's OWN key, from a Helius account the site does not use: credits are counted per
# account, so sharing one with the site's RPC_URL drains the faucet (2026-10-21). Never
# NEXT_PUBLIC_RPC_URL, the browser one.
KEEPER_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# The fee payer: a funded throwaway. Never the deployer, never the upgrade authority.
KEEPER_KEYPAIR=/etc/soladrome-keeper/keypair.json

# Optional: pinged after every pass (healthchecks.io, free tier). The alert is the silence.
KEEPER_HEARTBEAT_URL=
